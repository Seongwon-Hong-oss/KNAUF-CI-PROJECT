VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Kakao Developers JavaScript key (register your site domains in the Kakao app settings).
VITE_KAKAO_JS_KEY=YOUR-KAKAO-JAVASCRIPT-KEY
# Optional: Supabase rejects some fake domains. If sign-up says the address is invalid, use a domain you own.
VITE_ACCOUNT_DOMAIN=ci-project.app